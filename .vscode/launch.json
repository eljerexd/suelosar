{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SuelosAR",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "templateFor": "",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "prod",
        "--dart-define-from-file=.vscode/supabase.env.json"
      ]
    },
    {
      "name": "SuelosAR Beta",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "templateFor": "",
      "preLaunchTask": "invalidate-beta-debug-build-cache",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "beta",
        "--dart-define-from-file=.vscode/supabase.env.json"
      ]
    },
    {
      "name": "SuelosAR MapLibre (experimental)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "templateFor": "",
      "preLaunchTask": "invalidate-beta-debug-build-cache",
      "flutterMode": "debug",
      "toolArgs": [
        "--flavor",
        "beta",
        "--dart-define-from-file=.vscode/supabase.env.json",
        "--dart-define=USE_MAPLIBRE_ENGINE=true"
      ]
    }
  ]
}
